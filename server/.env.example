# server/.env.example
SETTLEMENT_PROFILE=usdc
DEMO_HTS_TOKEN_ID=
DEMO_HTS_TOKEN_ADDRESS=
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_USDC_TESTNET_ADDRESS=0x0000000000000000000000000000000000068cda
HEDERA_USDC_TESTNET_ID=0.0.429274
ARENA_ADDRESS=0x8771D35f42e9cB46b7Ec55fb712DFEfC752f3ae0
HEDERA_ARENA_ACCOUNT_ID=0.0.xxxxx
ACCESS_CONTROL_VAULT_ADDRESS=0x73524775e7c01E862F8d0E381D1154d7939cC160
ROUNDING_VAULT_ADDRESS=0x9Cb289aa00508D1B1eb8Aa1Eb21F552Eed4dA37A
TIME_WINDOW_VAULT_ADDRESS=0xFf608EC643D5c10204c20dfe1A2a43ebC45CcCEd
VERIFIER_KEY=0x...
SERVER_WALLET_SECRET=...
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_FACILITATOR_ACCOUNT_ID=0.0.7162784

# Optional: enable real ERC-8004 mainnet writes. When unset, erc8004.ts runs in mock mode.
ERC8004_MAINNET_KEY=

# Local Postgres (docker compose) defaults — host port 5440 (5432 is taken by the local install):
DATABASE_URL=postgres://postgres:postgres@localhost:5440/code4ai

# Paths to compiled contract artifacts / sources (monorepo layout defaults):
CONTRACTS_OUT_DIR=../contracts/out
CONTRACTS_SRC_DIR=../contracts/src

# 'local' = dev stand-in tx ids; 'real' = actual Hedera testnet settlement
SETTLEMENT_MODE=local
PORT=8787
