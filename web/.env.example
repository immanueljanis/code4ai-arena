# web/.env.example
# Base URL of the CODE4AI server API (Phase 2). When unset, the web uses the
# in-memory MockArenaClient for a no-backend demo.
VITE_API_URL=http://localhost:8787
VITE_SUBGRAPH_URL=

# On-chain contract addresses used by the UI (submit-flow x402 binding).
VITE_ARENA_ADDRESS=0x8771D35f42e9cB46b7Ec55fb712DFEfC752f3ae0
VITE_USDC_ADDRESS=0x0000000000000000000000000000000000068cda

# Hedera explorer (HashScan) base for tx links (testnet).
VITE_EXPLORER_TX_BASE=https://hashscan.io/testnet/transaction/
